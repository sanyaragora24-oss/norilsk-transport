diff --git a/examples/inverted-hull-outlines/src/App.tsx b/examples/inverted-hull-outlines/src/App.tsx
new file mode 100644
index 0000000..1cece82
--- /dev/null
+++ b/examples/inverted-hull-outlines/src/App.tsx
@@ -0,0 +1,44 @@
+import { useRef } from "react";
+import * as THREE from "three";
+import { Canvas, useFrame } from "@react-three/fiber";
+import { OrbitControls, Outlines } from "@react-three/drei";
+
+function Spin({ children }: { children: React.ReactNode }) {
+  const ref = useRef<THREE.Group>(null!);
+  useFrame((_, delta) => (ref.current.rotation.y += delta / 4));
+  return <group ref={ref}>{children}</group>;
+}
+
+export default function App() {
+  return (
+    <Canvas camera={{ position: [0, 1.5, 8.5], fov: 40 }}>
+      <color attach="background" args={["#f5f0e6"]} />
+      <ambientLight intensity={Math.PI / 2} />
+      <directionalLight position={[4, 6, 4]} intensity={Math.PI} />
+      <Spin>
+        {/* With drei 10.7.8 the default mode pushes the hull out in clip
+            space, so `thickness` is a size on screen and the line stays put
+            when you zoom. */}
+        <mesh position={[-2.2, 0, 0]}>
+          <boxGeometry args={[1.4, 1.4, 1.4]} />
+          <meshToonMaterial color="#ff8fab" />
+          <Outlines thickness={4} color="black" />
+        </mesh>
+        {/* `angle={0}` skips the creased normals, which suits a smooth knot. */}
+        <mesh>
+          <torusKnotGeometry args={[0.6, 0.22, 128, 32]} />
+          <meshToonMaterial color="#8ecae6" />
+          <Outlines thickness={3} color="black" angle={0} />
+        </mesh>
+        {/* `screenspace` pushes the hull along the normals in world units
+            instead, so this outline grows and shrinks with the sphere. */}
+        <mesh position={[2.2, 0, 0]}>
+          <sphereGeometry args={[0.85, 32, 32]} />
+          <meshToonMaterial color="#ffd166" />
+          <Outlines thickness={0.06} screenspace color="black" />
+        </mesh>
+      </Spin>
+      <OrbitControls enablePan={false} />
+    </Canvas>
+  );
+}
