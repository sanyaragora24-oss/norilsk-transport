diff --git a/examples/surface-sampling/src/App.tsx b/examples/surface-sampling/src/App.tsx
new file mode 100644
index 0000000..484d08e
--- /dev/null
+++ b/examples/surface-sampling/src/App.tsx
@@ -0,0 +1,45 @@
+import { useRef } from "react";
+import * as THREE from "three";
+import { Canvas, useFrame } from "@react-three/fiber";
+import { OrbitControls, Sampler, type TransformFn } from "@react-three/drei";
+
+const up = new THREE.Vector3(0, 1, 0);
+
+// Called once per sample: place the instance on the sampled point and stand
+// it up along the surface normal, with a little random height.
+const alignToNormal: TransformFn = ({ position, normal, dummy }) => {
+  dummy.position.copy(position);
+  dummy.quaternion.setFromUnitVectors(up, normal);
+  dummy.scale.setScalar(0.6 + Math.random() * 0.8);
+};
+
+function Spikes() {
+  const ref = useRef<THREE.Group>(null!);
+  useFrame((_, delta) => (ref.current.rotation.y += delta / 6));
+  return (
+    <group ref={ref}>
+      <Sampler count={1000} transform={alignToNormal}>
+        <mesh>
+          <torusKnotGeometry args={[1.2, 0.4, 200, 32]} />
+          <meshStandardMaterial color="#264653" roughness={0.6} />
+        </mesh>
+        <instancedMesh args={[undefined, undefined, 1000]}>
+          <coneGeometry args={[0.05, 0.25, 8]} />
+          <meshStandardMaterial color="#e9c46a" />
+        </instancedMesh>
+      </Sampler>
+    </group>
+  );
+}
+
+export default function App() {
+  return (
+    <Canvas camera={{ position: [0, 0, 6], fov: 45 }}>
+      <color attach="background" args={["#f1faee"]} />
+      <ambientLight intensity={Math.PI / 3} />
+      <directionalLight position={[5, 5, 5]} intensity={Math.PI} />
+      <Spikes />
+      <OrbitControls enablePan={false} />
+    </Canvas>
+  );
+}
