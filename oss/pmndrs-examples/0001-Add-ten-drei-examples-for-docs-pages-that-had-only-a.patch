diff --git a/examples/selection-edges/src/App.tsx b/examples/selection-edges/src/App.tsx
new file mode 100644
index 0000000..836ade8
--- /dev/null
+++ b/examples/selection-edges/src/App.tsx
@@ -0,0 +1,46 @@
+import { useRef } from "react";
+import * as THREE from "three";
+import { Canvas, type ThreeElements } from "@react-three/fiber";
+import { Edges, OrbitControls, Select, useSelect } from "@react-three/drei";
+
+function Cube(props: ThreeElements["mesh"]) {
+  const ref = useRef<THREE.Mesh>(null!);
+  // The current selection, as an array of the selected objects.
+  const selected = useSelect();
+  const isSelected = selected.includes(ref.current);
+  return (
+    <mesh ref={ref} {...props}>
+      <boxGeometry />
+      <meshStandardMaterial color={isSelected ? "hotpink" : "orange"} />
+      {/* Edges pulls the geometry from its parent mesh. */}
+      <Edges
+        color={isSelected ? "white" : "#3a2a10"}
+        lineWidth={isSelected ? 2.5 : 1}
+        scale={isSelected ? 1.05 : 1.001}
+      />
+    </mesh>
+  );
+}
+
+const GRID = 4;
+const positions: [number, number, number][] = [];
+for (let x = 0; x < GRID; x++)
+  for (let z = 0; z < GRID; z++)
+    positions.push([(x - (GRID - 1) / 2) * 1.6, 0, (z - (GRID - 1) / 2) * 1.6]);
+
+export default function App() {
+  return (
+    <Canvas camera={{ position: [6, 6, 6], fov: 45 }}>
+      <color attach="background" args={["#202025"]} />
+      <ambientLight intensity={Math.PI / 4} />
+      <directionalLight position={[5, 10, 5]} intensity={Math.PI / 2} />
+      {/* Click to select, shift-click to add, shift-drag to box-select. */}
+      <Select box multiple>
+        {positions.map((position, i) => (
+          <Cube key={i} position={position} />
+        ))}
+      </Select>
+      <OrbitControls makeDefault />
+    </Canvas>
+  );
+}
