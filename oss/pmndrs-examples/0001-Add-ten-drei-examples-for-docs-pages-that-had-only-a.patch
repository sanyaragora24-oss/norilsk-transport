diff --git a/examples/studio-backdrop/src/App.tsx b/examples/studio-backdrop/src/App.tsx
new file mode 100644
index 0000000..c21e618
--- /dev/null
+++ b/examples/studio-backdrop/src/App.tsx
@@ -0,0 +1,49 @@
+import { Canvas } from "@react-three/fiber";
+import { Backdrop, OrbitControls } from "@react-three/drei";
+
+export default function App() {
+  return (
+    <Canvas shadows camera={{ position: [0, 3, 9], fov: 35 }}>
+      <color attach="background" args={["#e6e2da"]} />
+      <ambientLight intensity={Math.PI / 4} />
+      <spotLight
+        position={[4, 8, 6]}
+        angle={0.5}
+        penumbra={1}
+        decay={0}
+        intensity={Math.PI}
+        castShadow
+        shadow-mapSize={2048}
+        shadow-bias={-0.0001}
+      />
+      <mesh position={[-1.6, 0.5, 0]} castShadow>
+        <boxGeometry />
+        <meshStandardMaterial color="#e07a5f" />
+      </mesh>
+      <mesh position={[0, 0.75, 0.5]} castShadow>
+        <sphereGeometry args={[0.75, 32, 32]} />
+        <meshStandardMaterial color="#3d405b" />
+      </mesh>
+      <mesh position={[1.6, 0.6, -0.3]} castShadow>
+        <coneGeometry args={[0.6, 1.2, 32]} />
+        <meshStandardMaterial color="#81b29a" />
+      </mesh>
+      {/* A plane bent up at the back, like a studio cyclorama. `floor` is
+          how far the flat part extends; `segments` the bend's resolution. */}
+      <Backdrop
+        floor={0.5}
+        segments={20}
+        receiveShadow
+        scale={[30, 8, 8]}
+        position={[0, 0, -1]}
+      >
+        <meshStandardMaterial color="#f2cc8f" />
+      </Backdrop>
+      <OrbitControls
+        makeDefault
+        target={[0, 1, 0]}
+        maxPolarAngle={Math.PI / 2.2}
+      />
+    </Canvas>
+  );
+}
