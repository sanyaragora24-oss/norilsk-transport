diff --git a/examples/infinite-grid/src/App.tsx b/examples/infinite-grid/src/App.tsx
new file mode 100644
index 0000000..2c093ad
--- /dev/null
+++ b/examples/infinite-grid/src/App.tsx
@@ -0,0 +1,38 @@
+import { Canvas } from "@react-three/fiber";
+import { Grid, OrbitControls } from "@react-three/drei";
+
+export default function App() {
+  return (
+    <Canvas camera={{ position: [10, 6, 10], fov: 35 }}>
+      <color attach="background" args={["#0d0d12"]} />
+      <ambientLight intensity={Math.PI / 4} />
+      <directionalLight position={[5, 10, 5]} intensity={Math.PI / 2} />
+      <mesh position={[-2, 0.5, 0]}>
+        <boxGeometry />
+        <meshStandardMaterial color="#f28482" />
+      </mesh>
+      <mesh position={[0, 0.75, -1.5]}>
+        <sphereGeometry args={[0.75, 32, 32]} />
+        <meshStandardMaterial color="#84a59d" />
+      </mesh>
+      <mesh position={[2, 0.6, 0.5]}>
+        <coneGeometry args={[0.6, 1.2, 32]} />
+        <meshStandardMaterial color="#f6bd60" />
+      </mesh>
+      {/* A y-up grid drawn in a shader. `infiniteGrid` extends it past the
+          plane's own size; `fadeDistance` fades it out from the camera. */}
+      <Grid
+        infiniteGrid
+        cellSize={0.5}
+        cellThickness={0.6}
+        cellColor="#3a3a4a"
+        sectionSize={2.5}
+        sectionThickness={1.2}
+        sectionColor="#7b8cde"
+        fadeDistance={40}
+        fadeStrength={1.5}
+      />
+      <OrbitControls makeDefault maxPolarAngle={Math.PI / 2.1} />
+    </Canvas>
+  );
+}
