diff --git a/examples/gradient-distort/src/App.tsx b/examples/gradient-distort/src/App.tsx
new file mode 100644
index 0000000..d713b26
--- /dev/null
+++ b/examples/gradient-distort/src/App.tsx
@@ -0,0 +1,55 @@
+import { Canvas } from "@react-three/fiber";
+import {
+  GradientTexture,
+  GradientType,
+  MeshDistortMaterial,
+  OrbitControls,
+} from "@react-three/drei";
+
+function Blob() {
+  return (
+    <mesh>
+      <sphereGeometry args={[1, 96, 96]} />
+      {/* The material displaces vertices with simplex noise; the texture is
+          a canvas gradient that attaches itself to `map`. */}
+      <MeshDistortMaterial distort={0.45} speed={2} roughness={0.2}>
+        <GradientTexture
+          stops={[0, 0.4, 1]}
+          colors={["#ff2d75", "#ffb347", "#3ddad7"]}
+          size={1024}
+        />
+      </MeshDistortMaterial>
+    </mesh>
+  );
+}
+
+function Backdrop() {
+  return (
+    <mesh position={[0, 0, -3]}>
+      <planeGeometry args={[20, 20]} />
+      <meshBasicMaterial>
+        <GradientTexture
+          stops={[0, 1]}
+          colors={["#2b2d42", "#0b0c10"]}
+          size={1024}
+          width={1024}
+          type={GradientType.Radial}
+          innerCircleRadius={0}
+          outerCircleRadius="auto"
+        />
+      </meshBasicMaterial>
+    </mesh>
+  );
+}
+
+export default function App() {
+  return (
+    <Canvas camera={{ position: [0, 0, 4], fov: 45 }}>
+      <ambientLight intensity={Math.PI / 4} />
+      <directionalLight position={[3, 3, 3]} intensity={Math.PI} />
+      <Backdrop />
+      <Blob />
+      <OrbitControls enablePan={false} />
+    </Canvas>
+  );
+}
