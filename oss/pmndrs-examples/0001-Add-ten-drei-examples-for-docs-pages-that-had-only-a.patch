diff --git a/examples/camera-controls/src/App.tsx b/examples/camera-controls/src/App.tsx
new file mode 100644
index 0000000..b082760
--- /dev/null
+++ b/examples/camera-controls/src/App.tsx
@@ -0,0 +1,69 @@
+import { useRef } from "react";
+import * as THREE from "three";
+import { Canvas } from "@react-three/fiber";
+import { CameraControls } from "@react-three/drei";
+
+const DEG45 = Math.PI / 4;
+
+const shapes = [
+  { position: [-2.5, 0.5, 0], color: "#e76f51", geometry: "box" },
+  { position: [0, 0.75, 0], color: "#2a9d8f", geometry: "sphere" },
+  { position: [2.5, 0.5, 0], color: "#e9c46a", geometry: "cone" },
+] as const;
+
+export default function App() {
+  const controls = useRef<CameraControls>(null);
+  return (
+    <>
+      <Canvas camera={{ position: [0, 3, 8], fov: 45 }}>
+        <color attach="background" args={["#1a1a2e"]} />
+        <ambientLight intensity={Math.PI / 4} />
+        <directionalLight position={[5, 8, 5]} intensity={Math.PI} />
+        <mesh rotation={[-Math.PI / 2, 0, 0]}>
+          <planeGeometry args={[20, 20]} />
+          <meshStandardMaterial color="#16213e" />
+        </mesh>
+        {shapes.map(({ position, color, geometry }, i) => (
+          <mesh
+            key={i}
+            position={position}
+            // Fit the camera to whatever was clicked, with a transition.
+            onClick={(e) => (
+              e.stopPropagation(),
+              controls.current?.fitToBox(e.object as THREE.Mesh, true, {
+                paddingTop: 1,
+                paddingBottom: 1,
+                paddingLeft: 1,
+                paddingRight: 1,
+              })
+            )}
+          >
+            {geometry === "box" && <boxGeometry />}
+            {geometry === "sphere" && <sphereGeometry args={[0.75, 32, 32]} />}
+            {geometry === "cone" && <coneGeometry args={[0.6, 1.2, 32]} />}
+            <meshStandardMaterial color={color} />
+          </mesh>
+        ))}
+        <CameraControls ref={controls} minDistance={2} maxDistance={20} />
+      </Canvas>
+      <div className="controls">
+        <button onClick={() => controls.current?.rotate(DEG45, 0, true)}>
+          rotate θ 45°
+        </button>
+        <button onClick={() => controls.current?.rotate(-DEG45, 0, true)}>
+          rotate θ -45°
+        </button>
+        <button onClick={() => controls.current?.rotate(0, DEG45 / 2, true)}>
+          rotate φ 22.5°
+        </button>
+        <button onClick={() => controls.current?.dolly(1, true)}>
+          dolly in
+        </button>
+        <button onClick={() => controls.current?.dolly(-1, true)}>
+          dolly out
+        </button>
+        <button onClick={() => controls.current?.reset(true)}>reset</button>
+      </div>
+    </>
+  );
+}
