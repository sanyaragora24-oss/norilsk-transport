diff --git a/examples/pivot-controls/src/App.tsx b/examples/pivot-controls/src/App.tsx
new file mode 100644
index 0000000..6d4e1d7
--- /dev/null
+++ b/examples/pivot-controls/src/App.tsx
@@ -0,0 +1,52 @@
+import { Canvas } from "@react-three/fiber";
+import { Grid, OrbitControls, PivotControls } from "@react-three/drei";
+
+export default function App() {
+  return (
+    <Canvas camera={{ position: [5, 4, 6], fov: 40 }}>
+      <color attach="background" args={["#f0eee9"]} />
+      <ambientLight intensity={Math.PI / 2} />
+      <directionalLight position={[5, 10, 5]} intensity={Math.PI / 2} />
+      {/* Anchored to the bottom-left-back corner of the box's bounds, with
+          HTML annotations that print the value while dragging. */}
+      <PivotControls
+        anchor={[-1, -1, -1]}
+        scale={0.75}
+        depthTest={false}
+        annotations
+      >
+        <mesh position={[-2, 0.5, 0]}>
+          <boxGeometry />
+          <meshStandardMaterial color="#ef476f" />
+        </mesh>
+      </PivotControls>
+      {/* Fixed keeps the gizmo the same size on screen at any distance. */}
+      <PivotControls fixed scale={80} depthTest={false} lineWidth={3}>
+        <mesh position={[0, 0.75, -1.5]}>
+          <sphereGeometry args={[0.75, 32, 32]} />
+          <meshStandardMaterial color="#06d6a0" />
+        </mesh>
+      </PivotControls>
+      {/* Translation only: rotation and scaling rings are switched off. */}
+      <PivotControls
+        anchor={[0, 1, 0]}
+        offset={[0, 0.5, 0]}
+        disableRotations
+        disableScaling
+        depthTest={false}
+      >
+        <mesh position={[2, 0.6, 0.5]}>
+          <coneGeometry args={[0.6, 1.2, 32]} />
+          <meshStandardMaterial color="#118ab2" />
+        </mesh>
+      </PivotControls>
+      <Grid
+        infiniteGrid
+        cellColor="#c9c5bb"
+        sectionColor="#8a857a"
+        fadeDistance={30}
+      />
+      <OrbitControls makeDefault />
+    </Canvas>
+  );
+}
