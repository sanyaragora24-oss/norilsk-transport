--- /dev/null
+++ b/examples/ascii-renderer/src/App.tsx
@@ -0,0 +1,40 @@
+import { useRef } from "react";
+import * as THREE from "three";
+import { Canvas, useFrame } from "@react-three/fiber";
+import { AsciiRenderer, OrbitControls } from "@react-three/drei";
+
+function Knot() {
+  const ref = useRef<THREE.Mesh>(null!);
+  useFrame((_, delta) => {
+    ref.current.rotation.x += delta / 2;
+    ref.current.rotation.y += delta / 3;
+  });
+  return (
+    <mesh ref={ref}>
+      <torusKnotGeometry args={[1, 0.35, 200, 32]} />
+      <meshStandardMaterial color="white" />
+    </mesh>
+  );
+}
+
+export default function App() {
+  return (
+    <Canvas camera={{ position: [0, 0, 5], fov: 50 }}>
+      <color attach="background" args={["black"]} />
+      <ambientLight intensity={Math.PI / 4} />
+      <spotLight
+        position={[10, 10, 10]}
+        angle={0.15}
+        penumbra={1}
+        decay={0}
+        intensity={Math.PI}
+      />
+      <pointLight position={[-10, -10, -10]} decay={0} intensity={Math.PI} />
+      <Knot />
+      <OrbitControls />
+      {/* Replaces the WebGL output with a layer of characters. `resolution`
+          trades detail for cell size; `invert` swaps the character ramp. */}
+      <AsciiRenderer fgColor="white" bgColor="black" resolution={0.18} />
+    </Canvas>
+  );
