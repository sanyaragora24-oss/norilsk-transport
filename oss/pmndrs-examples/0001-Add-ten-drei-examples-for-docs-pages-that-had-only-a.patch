diff --git a/examples/round-points/src/App.tsx b/examples/round-points/src/App.tsx
new file mode 100644
index 0000000..0f6845e
--- /dev/null
+++ b/examples/round-points/src/App.tsx
@@ -0,0 +1,41 @@
+import { useMemo, useRef } from "react";
+import * as THREE from "three";
+import { Canvas, useFrame } from "@react-three/fiber";
+import { PointMaterial, Points } from "@react-three/drei";
+import * as random from "maath/random";
+
+const COUNT = 5000;
+
+function Cloud() {
+  const ref = useRef<THREE.Points>(null!);
+  const positions = useMemo(
+    () => random.inSphere(new Float32Array(COUNT * 3), { radius: 1.5 }),
+    [],
+  );
+  useFrame((_, delta) => {
+    ref.current.rotation.x -= delta / 10;
+    ref.current.rotation.y -= delta / 15;
+  });
+  return (
+    <Points ref={ref} positions={positions as Float32Array} stride={3}>
+      {/* Same props as THREE.PointsMaterial, but every point is a round,
+          antialiased dot rather than a square sprite. */}
+      <PointMaterial
+        transparent
+        color="#ffa0e0"
+        size={0.02}
+        sizeAttenuation
+        depthWrite={false}
+      />
+    </Points>
+  );
+}
+
+export default function App() {
+  return (
+    <Canvas camera={{ position: [0, 0, 3], fov: 60 }}>
+      <color attach="background" args={["#0b0b1a"]} />
+      <Cloud />
+    </Canvas>
+  );
+}
