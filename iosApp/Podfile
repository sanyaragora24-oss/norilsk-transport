# Podfile для iosApp
# Запустить: pod install в директории iosApp после открытия .xcworkspace

platform :ios, '17.0'

target 'NorilskTransit' do
  use_frameworks!

  # Яндекс MapKit iOS SDK
  pod 'YandexMapsMobile', '~> 4.5'

  # Firebase (Crashlytics, Messaging, Analytics)
  pod 'Firebase/Crashlytics'
  pod 'Firebase/Messaging'
  pod 'Firebase/Analytics'

  # Alamofire — HTTP
  pod 'Alamofire', '~> 5.9'

  # SwiftyJSON — парсинг
  pod 'SwiftyJSON', '~> 5.0'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.0'
      # Разрешаем bitcode для YandexMapsMobile
      config.build_settings['ENABLE_BITCODE'] = 'YES'
      config.build_settings['SWIFT_VERSION'] = '5.0'
    end
  end
end
