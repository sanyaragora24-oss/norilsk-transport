# Podfile для iosApp
# Запустить: cd iosApp && xcodegen generate && pod install
#
# ВАЖНО по YandexMapsMobile:
# Все версии пода (272 штуки) публикуются ТОЛЬКО с суффиксом варианта:
#   -lite / -full / -navikit / -flutter, например 4.45.0-lite
# CocoaPods/Gem считает такие версии pre-release, поэтому ограничение
# вида  '~> 4.5'  НЕ МОЖЕТ разрешиться ни в одну версию — именно из-за этого
# шаг "Install pods" падал в CI с
#   [!] CocoaPods could not find compatible versions for pod "YandexMapsMobile".
# Поэтому версия фиксируется полностью: 4.45.0 — актуальная версия SDK
# (совпадает с официальным SPM-пакетом yandex/mapkit-ios, тег 4.45.0).
#
# Вариант lite, а не full:
#   - lite = карта, пробки, LocationManager, UserLocationLayer — этого достаточно
#     для полилиний маршрутов и позиции пользователя;
#   - full добавляет роутинг/поиск/панорамы и раздувает бандл на сотни МБ
#     (только симуляторный слайс YandexMapsMobile.framework — 409 МБ).
#   - Модуль в обоих вариантах называется YandexMapsMobile (prepare_command
#     переименовывает YandexMapsMobileLite.xcframework), поэтому import в коде
#     не меняется.
# Когда понадобятся поиск/роутинг — заменить на '4.45.0-full'.

platform :ios, '17.0'

target 'NorilskTransit' do
  use_frameworks!

  # Яндекс MapKit iOS SDK (iOS 15.0+, vendored YandexMapsMobile.xcframework)
  pod 'YandexMapsMobile', '4.45.0-lite'

  # Ниже — зависимости следующих этапов. Сейчас они отключены намеренно:
  # этап 1 = только стабильная сборка. Ничего из этого не импортируется
  # в Sources/, так что их отсутствие не ломает код.
  #
  # pod 'Firebase/Crashlytics'
  # pod 'Firebase/Messaging'
  # pod 'Firebase/Analytics'
  # pod 'Alamofire', '~> 5.9'
  # pod 'SwiftyJSON', '~> 5.0'
end

# Значение ключа карты: сначала переменная окружения (релизная сборка, секрет
# YANDEX_MAPKIT_API_KEY), иначе — gitignored Secrets.xcconfig (локальная разработка).
# Пусто, если ключ не задан: приложение показывает состояние «не задан»,
# но собирается и работает. Сам ключ НИКОГДА не печатается в лог pod install.
def mapkit_api_key
  candidates = []

  env_value = ENV['YANDEX_MAPKIT_API_KEY'].to_s.strip
  candidates << env_value unless env_value.empty? || env_value.start_with?('$(')

  secrets_path = File.join(__dir__, 'Secrets.xcconfig')
  if File.exist?(secrets_path)
    line = File.readlines(secrets_path).find { |l| l =~ /^\s*YANDEX_MAPKIT_API_KEY\s*=/ }
    file_value = line.to_s.split('=', 2).last.to_s.strip
    candidates << file_value unless file_value.empty? || file_value.start_with?('$(')
  end

  candidates.first.to_s
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.0'
      # Bitcode удалён в Xcode 14+, а YandexMapsMobile поставляется без него:
      # ENABLE_BITCODE=YES гарантированно ломает линковку на device/archive.
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      config.build_settings['SWIFT_VERSION'] = '5.0'
    end
  end

  # Ключ карты — в build settings приложения, откуда он подставляется в
  # Info.plist ($(YANDEX_MAPKIT_API_KEY)). Base configuration трогать нельзя:
  # её целиком ведёт CocoaPods, подмена ломает интеграцию подов.
  # Значение оседает только в локальном .xcodeproj (он в .gitignore) и в
  # Info.plist собранного .app.
  api_key = mapkit_api_key
  configured = !api_key.empty?
  installer.aggregate_targets.each do |aggregate_target|
    project = aggregate_target.user_project
    project.targets.each do |target|
      next unless target.name == 'NorilskTransit'
      target.build_configurations.each do |config|
        config.build_settings['YANDEX_MAPKIT_API_KEY'] = api_key
      end
    end
    project.save
  end
  puts "MapKit API key: #{configured ? 'задан (значение не печатается)' : 'не задан'}"
end
