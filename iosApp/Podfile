# Podfile для iosApp
# Запустить: pod install в директории iosApp после открытия .xcworkspace

platform :ios, '17.0'

target 'NorilskTransit' do
  use_frameworks!

  # Яндекс MapKit iOS SDK. Все версии пода публикуются с суффиксом
  # (-lite / -full / -navikit), и CocoaPods считает их пре-релизами:
  # без точной версии pod install падает. Приложению нужны только карта,
  # линии и камера — хватает lite.
  pod 'YandexMapsMobile', '4.9.0-lite'

  # Firebase (Crashlytics, Messaging, Analytics)
  pod 'Firebase/Crashlytics'
  pod 'Firebase/Messaging'
  pod 'Firebase/Analytics'

  # Alamofire — HTTP
  pod 'Alamofire', '~> 5.9'

  # SwiftyJSON — парсинг
  pod 'SwiftyJSON', '~> 5.0'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.0'
      config.build_settings['SWIFT_VERSION'] = '5.0'
    end
  end
end
